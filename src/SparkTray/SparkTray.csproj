<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SparkTray</RootNamespace>
    <AssemblyName>SparkTray</AssemblyName>
    <Version>0.1.1</Version>
    <Product>DGX Spark Status Tray</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\icons\dgx-spark-status-tray-Application-icon.ico</ApplicationIcon>

    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SparkTray.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The exe/taskbar icon (wired via ApplicationIcon above) isn't one of the tray-state
         icons TrayIcons.cs loads by name, so it's excluded here. -->
    <EmbeddedResource Include="assets\icons\*.ico" Exclude="assets\icons\dgx-spark-status-tray-Application-icon.ico" />
  </ItemGroup>

</Project>
